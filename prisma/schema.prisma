generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  title       String       @unique
  description String?
  body        String
  published   Boolean      @default(false)
  createAte   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  id          Int          @id @default(autoincrement())
  categories  Categories[]
  image       String
}

enum Categories {
  TUTORIAL
  TECH_NEWS
  FINANCE
}
