generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  id          Int          @id @default(autoincrement())
  imageUrl       String
  title       String       @unique
  description String?
  body        String
  categories  Categories[]
  published   Boolean      @default(false)
  createAte   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum Categories {
  TUTORIAL
  TECH_NEWS
  FINANCE
}
